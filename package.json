{
  "name": "autotesting-zags",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:cucumber": "cucumber-js",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/apiTests.spec.js",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report --host 0.0.0.0 --port 62051",
    "test:allure": "npm run allure:clean && npm test && npm run allure:generate && npm run allure:open",
    "test:api:allure": "npm run allure:clean && npm run test:api && npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "ajv": "^8.17.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
